        <mxCell id="book-ask" parent="1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Nhắn Tripi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;“Muốn đi Đà Lạt 2N1Đ”&lt;/span&gt;" vertex="1" style="html=1;fontFamily=Arial;fillColor=#EDF3FF;strokeColor=#7E9BD5;fontColor=#244981;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=15;spacingTop=5;spacingBottom=5;">
