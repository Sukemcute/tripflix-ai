        <mxCell id="book-suggest" parent="1" value="&lt;span style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Nhận thẻ video nếu có&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;AI tìm theo điểm đến. Mobile mở reel nếu video có trong feed.&lt;/span&gt;" vertex="1" style="html=1;fontFamily=Arial;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=15;spacingTop=5;spacingBottom=5;fillColor=#B9F0C2;strokeColor=#0B6B2B;fontColor=#053D17;strokeWidth=3;">
