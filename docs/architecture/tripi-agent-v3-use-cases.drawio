        <mxCell id="context-q-room" parent="1" value="&lt;b style=&quot;font-size:18px&quot;&gt;“Khách sạn này còn phòng?”&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Hỏi theo ngày và số người.&lt;/span&gt;" vertex="1" style="html=1;fontFamily=Arial;fillColor=#EDF3FF;strokeColor=#7E9BD5;fontColor=#244981;rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=15;spacingRight=15;spacingTop=5;spacingBottom=5;">
