{
  "components": {
    "schemas": {
      "CardRef": {
        "additionalProperties": false,
        "description": "A card shown in the last answer, so \"the second video\" can be found again.",
        "properties": {
          "id": {
            "maxLength": 100,
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "maxLength": 20,
            "title": "Kind",
            "type": "string"
          },
          "ref": {
            "maxLength": 8,
            "title": "Ref",
            "type": "string"
          },
          "title": {
            "default": "",
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "kind",
          "id"
        ],
        "title": "CardRef",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "contextPostId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contextpostid"
          },
          "conversationId": {
            "format": "uuid",
            "title": "Conversationid",
            "type": "string"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "maxItems": 10,
            "title": "History",
            "type": "array"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message",
            "type": "string"
          },
          "searchMode": {
            "anyOf": [
              {
                "const": "reel",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Searchmode"
          },
          "trip": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TripContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "conversationId",
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModerateItem": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "imageUrls": {
            "items": {
              "maxLength": 2048,
              "pattern": "^https://\\S+$",
              "type": "string"
            },
            "maxItems": 4,
            "title": "Imageurls",
            "type": "array"
          },
          "text": {
            "default": "",
            "maxLength": 10000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "ModerateItem",
        "type": "object"
      },
      "ModerateRequest": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ModerateItem"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ModerateRequest",
        "type": "object"
      },
      "ModerateResponse": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ModerateResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results",
          "model"
        ],
        "title": "ModerateResponse",
        "type": "object"
      },
      "ModerateResult": {
        "additionalProperties": false,
        "properties": {
          "categories": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Categories",
            "type": "object"
          },
          "flagged": {
            "title": "Flagged",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "scores": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Scores",
            "type": "object"
          }
        },
        "required": [
          "id",
          "flagged",
          "categories",
          "scores"
        ],
        "title": "ModerateResult",
        "type": "object"
      },
      "TripContext": {
        "additionalProperties": false,
        "description": "What Tripi remembers of the trip being planned (trip memory, v3 \"Trip Draft\" lite).\n\nThe app keeps it and sends it back each turn; the server re-checks everything against\nCore before use, so an edited copy only spoils its own answers (DeepResearch \u00a75.1).",
        "properties": {
          "adults": {
            "default": 2,
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Adults",
            "type": "integer"
          },
          "asked": {
            "default": false,
            "title": "Asked",
            "type": "boolean"
          },
          "children": {
            "default": 0,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Children",
            "type": "integer"
          },
          "dateFrom": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Datefrom"
          },
          "dateTo": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dateto"
          },
          "infants": {
            "default": 0,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Infants",
            "type": "integer"
          },
          "lastCards": {
            "items": {
              "$ref": "#/components/schemas/CardRef"
            },
            "maxItems": 5,
            "title": "Lastcards",
            "type": "array"
          },
          "place": {
            "default": "",
            "maxLength": 100,
            "title": "Place",
            "type": "string"
          },
          "priceMaxPerNight": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricemaxpernight"
          },
          "reelId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reelid"
          },
          "v": {
            "const": 1,
            "default": 1,
            "title": "V",
            "type": "integer"
          }
        },
        "title": "TripContext",
        "type": "object"
      },
      "Turn": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "answer",
            "enum": [
              "answer",
              "clarify",
              "refusal",
              "no_result",
              "fallback"
            ],
            "title": "Kind",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "role",
          "text"
        ],
        "title": "Turn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Tripflix AI Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/chat": {
      "post": {
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "TURN_IN_PROGRESS"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "RATE_LIMITED or GUEST_LIMIT_REACHED (loginRequired)"
          },
          "503": {
            "description": "CHAT_BUSY"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Chat",
        "tags": [
          "assistant"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Get Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/moderate": {
      "post": {
        "operationId": "moderate_moderate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModerateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Moderate",
        "tags": [
          "moderation"
        ]
      }
    }
  }
}
