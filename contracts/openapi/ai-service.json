              "place",
              "dates",
              "origin",
              "origin_dates"
            ],
            "title": "Missing",
            "type": "string"
          },
          "nights": {
            "anyOf": [
              {
                "maximum": 30.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nights"
          }
        },
        "required": [
          "intent"
        ],
        "title": "Awaiting",
        "type": "object"
      },
