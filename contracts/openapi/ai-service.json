      "TripContext": {
        "additionalProperties": false,
        "description": "What Tripi remembers of the trip being planned (trip memory, v3 \"Trip Draft\" lite).\n\nThe app keeps it and sends it back each turn; the server re-checks everything against\nCore before use, so an edited copy only spoils its own answers (DeepResearch \u00a75.1).\nv2 (Stage B) adds the plan itself: origin city, stay, way there, stops per day, the\noptions on screen and the last edits. Kept small: the app stores the whole chat in 2 KB.",
        "properties": {
          "adults": {
            "default": 2,
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Adults",
            "type": "integer"
          },
          "asked": {
            "default": false,
            "title": "Asked",
            "type": "boolean"
          },
          "awaiting": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Awaiting"
              },
              {
                "type": "null"
              }
            ]
          },
          "children": {
            "default": 0,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Children",
            "type": "integer"
          },
          "dateFrom": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Datefrom"
          },
          "dateTo": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dateto"
          },
          "days": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/DraftStop"
              },
              "type": "array"
            },
            "maxItems": 7,
            "title": "Days",
            "type": "array"
          },
          "infants": {
            "default": 0,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Infants",
            "type": "integer"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "title": "Interests",
            "type": "array"
          },
          "lastCards": {
            "items": {
              "$ref": "#/components/schemas/CardRef"
            },
            "maxItems": 5,
            "title": "Lastcards",
            "type": "array"
          },
          "mealsOnly": {
            "default": false,
            "title": "Mealsonly",
            "type": "boolean"
          },
          "ops": {
            "items": {
              "$ref": "#/components/schemas/DraftOp"
            },
            "maxItems": 5,
            "title": "Ops",
            "type": "array"
          },
          "originCity": {
            "default": "",
            "maxLength": 60,
            "title": "Origincity",
            "type": "string"
          },
          "pending": {
            "items": {
              "$ref": "#/components/schemas/DraftChoice"
            },
            "maxItems": 4,
            "title": "Pending",
            "type": "array"
          },
          "pendingFlights": {
            "items": {
              "$ref": "#/components/schemas/DraftTransport"
            },
            "maxItems": 5,
            "title": "Pendingflights",
            "type": "array"
          },
          "place": {
            "default": "",
            "maxLength": 100,
            "title": "Place",
            "type": "string"
          },
          "priceMaxPerNight": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricemaxpernight"
          },
          "reelId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reelid"
          },
          "returnTransport": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftTransport"
              },
              {
                "type": "null"
              }
            ]
          },
          "stay": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftChoice"
              },
              {
                "type": "null"
              }
            ]
          },
          "transport": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftTransport"
              },
              {
                "type": "null"
              }
            ]
          },
          "v": {
            "default": 2,
            "enum": [
              1,
              2
            ],
            "title": "V",
            "type": "integer"
          }
        },
        "title": "TripContext",
        "type": "object"
      },
      "Turn": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "answer",
            "enum": [
              "answer",
              "clarify",
              "refusal",
              "no_result",
              "fallback"
            ],
            "title": "Kind",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "role",
          "text"
        ],
        "title": "Turn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
