          "intent": {
            "enum": [
              "search",
              "find_stay",
              "find_flight",
              "plan_trip",
              "weather",
              "packing",
              "find_reel",
              "change_transport"
            ],
            "title": "Intent",
            "type": "string"
          },
          "missing": {
            "default": "place",
