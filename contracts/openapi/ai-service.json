{
  "components": {
    "schemas": {
      "Awaiting": {
        "additionalProperties": false,
        "description": "The request Tripi asked a question about and still has to finish.",
        "properties": {
          "intent": {
            "enum": [
              "search",
              "find_stay",
              "find_flight",
              "plan_trip",
              "weather",
              "packing",
              "find_reel"
            ],
            "title": "Intent",
            "type": "string"
          },
          "missing": {
            "default": "place",
            "enum": [
              "place",
              "dates",
              "origin"
            ],
            "title": "Missing",
            "type": "string"
          },
          "nights": {
            "anyOf": [
              {
                "maximum": 30.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nights"
          }
        },
        "required": [
          "intent"
        ],
        "title": "Awaiting",
        "type": "object"
      },
      "CardRef": {
        "additionalProperties": false,
        "description": "A card shown in the last answer, so \"the second video\" can be found again.",
        "properties": {
          "id": {
            "maxLength": 100,
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "maxLength": 20,
            "title": "Kind",
            "type": "string"
          },
          "ref": {
            "maxLength": 8,
            "title": "Ref",
            "type": "string"
          },
          "title": {
            "default": "",
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "ref",
          "kind",
          "id"
        ],
        "title": "CardRef",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftAction"
              },
              {
                "type": "null"
              }
            ]
          },
          "contextPostId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contextpostid"
          },
          "conversationId": {
            "format": "uuid",
            "title": "Conversationid",
            "type": "string"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "maxItems": 30,
            "title": "History",
            "type": "array"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message",
            "type": "string"
          },
          "searchMode": {
            "anyOf": [
              {
                "const": "reel",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Searchmode"
          },
          "trip": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TripContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "conversationId",
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "DraftAction": {
        "additionalProperties": false,
        "description": "A button the user tapped: run as a draft edit without the LLM (DeepResearch \u00a75.2).",
        "properties": {
          "ref": {
            "default": "",
            "maxLength": 4,
            "title": "Ref",
            "type": "string"
          },
          "stopId": {
            "default": "",
            "maxLength": 100,
            "title": "Stopid",
            "type": "string"
          },
          "type": {
            "enum": [
              "select",
              "remove_stop",
              "undo"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "DraftAction",
        "type": "object"
      },
      "DraftChoice": {
        "additionalProperties": false,
        "description": "A stay the user picked or may pick: on Tripflix (bookable) or outside (for reference).",
        "properties": {
          "id": {
            "maxLength": 100,
            "title": "Id",
            "type": "string"
          },
          "lat": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "lng": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lng"
          },
          "name": {
            "maxLength": 120,
            "title": "Name",
            "type": "string"
          },
          "ref": {
            "default": "",
            "maxLength": 4,
            "title": "Ref",
            "type": "string"
          },
          "source": {
            "enum": [
              "tripflix",
              "external"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "id",
          "name"
        ],
        "title": "DraftChoice",
        "type": "object"
      },
      "DraftOp": {
        "additionalProperties": false,
        "description": "One edit, kept so \"ho\u00e0n t\u00e1c\" can undo it; only what is needed to put things back.",
        "properties": {
          "day": {
            "anyOf": [
              {
                "maximum": 13.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Day"
          },
          "op": {
            "enum": [
              "set_stay",
              "remove_stop"
            ],
            "title": "Op",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "maximum": 12.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "stay": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftChoice"
              },
              {
                "type": "null"
              }
            ]
          },
          "stop": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftStop"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "op"
        ],
        "title": "DraftOp",
        "type": "object"
      },
      "DraftStop": {
        "additionalProperties": false,
        "description": "A stop of the planned itinerary; coordinates kept so edits need no new lookup.",
        "properties": {
          "id": {
            "maxLength": 100,
            "title": "Id",
            "type": "string"
          },
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lng": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng",
            "type": "number"
          },
          "name": {
            "maxLength": 120,
            "title": "Name",
            "type": "string"
          },
          "slot": {
            "default": "s\u00e1ng",
            "enum": [
              "s\u00e1ng",
              "tr\u01b0a",
              "chi\u1ec1u",
              "t\u1ed1i"
            ],
            "title": "Slot",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "lat",
          "lng"
        ],
        "title": "DraftStop",
        "type": "object"
      },
      "DraftTransport": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "flight",
              "bus"
            ],
            "title": "Mode",
            "type": "string"
          },
          "summary": {
            "maxLength": 160,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "summary"
        ],
        "title": "DraftTransport",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModerateItem": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "imageUrls": {
            "items": {
              "maxLength": 2048,
              "pattern": "^https://\\S+$",
              "type": "string"
            },
            "maxItems": 4,
            "title": "Imageurls",
            "type": "array"
          },
          "text": {
            "default": "",
            "maxLength": 10000,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "ModerateItem",
        "type": "object"
      },
      "ModerateRequest": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ModerateItem"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ModerateRequest",
        "type": "object"
      },
      "ModerateResponse": {
        "additionalProperties": false,
        "properties": {
          "model": {
            "title": "Model",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ModerateResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results",
          "model"
        ],
        "title": "ModerateResponse",
        "type": "object"
      },
      "ModerateResult": {
        "additionalProperties": false,
        "properties": {
          "categories": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Categories",
            "type": "object"
          },
          "flagged": {
            "title": "Flagged",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "scores": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Scores",
            "type": "object"
          }
        },
        "required": [
          "id",
          "flagged",
          "categories",
          "scores"
        ],
        "title": "ModerateResult",
        "type": "object"
      },
      "TripContext": {
        "additionalProperties": false,
        "description": "What Tripi remembers of the trip being planned (trip memory, v3 \"Trip Draft\" lite).\n\nThe app keeps it and sends it back each turn; the server re-checks everything against\nCore before use, so an edited copy only spoils its own answers (DeepResearch \u00a75.1).\nv2 (Stage B) adds the plan itself: origin city, stay, way there, stops per day, the\noptions on screen and the last edits. Kept small: the app stores the whole chat in 2 KB.",
        "properties": {
          "adults": {
            "default": 2,
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Adults",
            "type": "integer"
          },
          "asked": {
            "default": false,
            "title": "Asked",
            "type": "boolean"
          },
          "awaiting": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Awaiting"
              },
              {
                "type": "null"
              }
            ]
          },
          "children": {
            "default": 0,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Children",
            "type": "integer"
          },
          "dateFrom": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Datefrom"
          },
          "dateTo": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dateto"
          },
          "days": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/DraftStop"
              },
              "type": "array"
            },
            "maxItems": 7,
            "title": "Days",
            "type": "array"
          },
          "infants": {
            "default": 0,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Infants",
            "type": "integer"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "title": "Interests",
            "type": "array"
          },
          "lastCards": {
            "items": {
              "$ref": "#/components/schemas/CardRef"
            },
            "maxItems": 5,
            "title": "Lastcards",
            "type": "array"
          },
          "mealsOnly": {
            "default": false,
            "title": "Mealsonly",
            "type": "boolean"
          },
          "ops": {
            "items": {
              "$ref": "#/components/schemas/DraftOp"
            },
            "maxItems": 5,
            "title": "Ops",
            "type": "array"
          },
          "originCity": {
            "default": "",
            "maxLength": 60,
            "title": "Origincity",
            "type": "string"
          },
          "pending": {
            "items": {
              "$ref": "#/components/schemas/DraftChoice"
            },
            "maxItems": 4,
            "title": "Pending",
            "type": "array"
          },
          "place": {
            "default": "",
            "maxLength": 100,
            "title": "Place",
            "type": "string"
          },
          "priceMaxPerNight": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pricemaxpernight"
          },
          "reelId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reelid"
          },
          "stay": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftChoice"
              },
              {
                "type": "null"
              }
            ]
          },
          "transport": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DraftTransport"
              },
              {
                "type": "null"
              }
            ]
          },
          "v": {
            "default": 2,
            "enum": [
              1,
              2
            ],
            "title": "V",
            "type": "integer"
          }
        },
        "title": "TripContext",
        "type": "object"
      },
      "Turn": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "default": "answer",
            "enum": [
              "answer",
              "clarify",
              "refusal",
              "no_result",
              "fallback"
            ],
            "title": "Kind",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "role",
          "text"
        ],
        "title": "Turn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Tripflix AI Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/chat": {
      "post": {
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "409": {
            "description": "TURN_IN_PROGRESS"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "RATE_LIMITED or GUEST_LIMIT_REACHED (loginRequired)"
          },
          "503": {
            "description": "CHAT_BUSY"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Chat",
        "tags": [
          "assistant"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Get Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/moderate": {
      "post": {
        "operationId": "moderate_moderate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModerateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Moderate",
        "tags": [
          "moderation"
        ]
      }
    }
  }
}
