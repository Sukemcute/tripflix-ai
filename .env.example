CORE_API_URL=http://localhost:3000
JWKS_URL=http://localhost:3000/.well-known/jwks.json
LOG_LEVEL=INFO
# fake | deepseek | openai | anthropic; fake runs offline with canned output
LLM_PROVIDER=fake
# empty = adapter default: deepseek-flash (deepseek), claude-haiku-5-5 (anthropic);
# openai has no default and needs LLM_MODEL plus the three LLM_PRICE_* below
LLM_MODEL=
# USD per 1M tokens for LLM_MODEL (cost is recorded for every call)
# LLM_PRICE_INPUT=
# LLM_PRICE_CACHED_INPUT=
# LLM_PRICE_OUTPUT=
# Keys: put them only in .env, never commit (OPENAI_API_KEY is below, shared with /moderate)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# minimal for reasoning models (gpt-5 family); empty for models without reasoning
# OPENAI_REASONING_EFFORT=minimal
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=3000
SUMMARY_LLM_KILL=false
# Service client for core-api (create it with core's auth:create-service-client; never commit)
SERVICE_CLIENT_ID=ai-service
SERVICE_CLIENT_SECRET=
REDIS_URL=redis://localhost:6379/0
# Fixed Redis consumer names (like VIDEO_WORKER_CONSUMER_NAME); empty: hostname-PID.
# Two replicas of one worker need different names.
SUMMARY_WORKER_CONSUMER_NAME=
LABEL_WORKER_CONSUMER_NAME=
# Comment classifier bundle (fetch: uv run python -m scripts.fetch_classifier --tag comment-classifier-v1).
# Missing bundle -> rules. Threads must match the container's CPU limit.
# CLASSIFIER_DIR=app/models/comment_classifier
CLASSIFIER_THREADS=2
CLASSIFIER_BATCH=8
# false: rules only, no rebuild needed (unplug the classifier)
CLASSIFIER_ENABLED=true
# newest N comments get labels per run (~25 s for 500); the rest use rules
CLASSIFIER_MAX_COMMENTS=500
# POST /moderate (TF32): OpenAI omni-moderation, key only in .env, never commit.
# Empty key -> /moderate answers 503 and core keeps its regex step.
OPENAI_API_KEY=
MODERATION_TIMEOUT_SECONDS=2.5
IS_MODERATION_SAFETY_SHADOW_ENABLED=false
# ViSoBERT is baked into Docker images; CPU inference adds review signals at 0.97.
IS_VISOBERT_ENABLED=false
VISOBERT_THRESHOLD=0.97
VISOBERT_THREADS=1
VISOBERT_BATCH_SIZE=4
VISOBERT_TIMEOUT_SECONDS=1.5
# VISOBERT_DIR=app/models/visobert_moderation
# POST /embed (TF28, e5-small INT8). Build: uv run --with onnx python -m scripts.export_e5 --out app/models/e5_embedding
# EMBEDDING_DIR=app/models/e5_embedding
# Core's service tokens: issuer as core's AUTH_JWT_ISSUER; JWKS defaults to {CORE_API_URL}/.well-known/jwks.json
AUTH_JWT_ISSUER=tripflix-core
# Origin trình duyệt được gọi /chat (Expo web, web OTA), cách nhau bằng dấu phẩy.
CORS_ORIGINS=http://localhost:3100,http://localhost:8081

# --- Tripi chat, POST /chat (TF31 v3). Limits are tunable defaults, see app/core/config.py ---
# Kill switch: false means Core search only, no LLM call
CHAT_LLM_ENABLED=false
# Turn off the Responder (fixed text only) or some Skills without a deploy, e.g. flight,stay.
CHAT_RESPONDER_ENABLED=true
CHAT_SKILLS_DISABLED=
# Controller (understands the message) on OpenAI, Responder (writes the reply) on DeepSeek.
# OpenAI needs a model and its three prices (USD per 1M tokens); keys are OPENAI_API_KEY and
# DEEPSEEK_API_KEY above, kept only in .env
CHAT_CONTROLLER_PROVIDER=openai
CHAT_CONTROLLER_MODEL=
CHAT_CONTROLLER_PRICE_INPUT=
CHAT_CONTROLLER_PRICE_CACHED_INPUT=
CHAT_CONTROLLER_PRICE_OUTPUT=
CHAT_RESPONDER_PROVIDER=deepseek
# CHAT_RESPONDER_MODEL=
# Guests may chat on a smaller budget; true restores login-only
CHAT_REQUIRE_LOGIN=false
# Long random value per environment: hashes a guest's IP into its counter key
CHAT_IDENTITY_SALT=
# CHAT_MAX_INFLIGHT=30
# Test limits (2026-11-17), wide on purpose; the release caps are decided later.
# CHAT_GUEST_DAILY_TURNS=300
# CHAT_GUEST_DAILY_TOKENS=1000000
# CHAT_USER_DAILY_TURNS=500
# CHAT_USER_DAILY_TOKENS=2000000
# CHAT_GUEST_HISTORY_TURNS=20
# CHAT_USER_HISTORY_TURNS=20
# CHAT_SYSTEM_DAILY_USD=3
