CORE_API_URL=http://localhost:3000
JWKS_URL=http://localhost:3000/.well-known/jwks.json
LOG_LEVEL=INFO
# fake | deepseek; fake runs offline with canned output
LLM_PROVIDER=fake
# deepseek-flash (default for deepseek) or deepseek-v4-pro
LLM_MODEL=
# DeepSeek key: put it only in .env, never commit
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=3000
SUMMARY_LLM_KILL=false
# Service client for core-api (create it with core's auth:create-service-client; never commit)
SERVICE_CLIENT_ID=ai-service
SERVICE_CLIENT_SECRET=
REDIS_URL=redis://localhost:6379/0
